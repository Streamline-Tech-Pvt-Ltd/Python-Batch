# Q1.print a maximum of 3 number using elif statement

a=int(input("Enter the number:"))
b=int(input("Enter the number:"))
c=int(input("Enter the number:"))
if a>=b & a>=c:
    print("Maximum=,a")
elif b>=a &b>=c:
    print("Maximum=,b")
else:
    print("Maximum=,C")


