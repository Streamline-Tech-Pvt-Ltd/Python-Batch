# Q3.print natural number/not
num=int(input("Enter the number"))
if num>=1:
    print("the Number is Natural  ")
else:
    print("the number is not natural number")

    Nested if-else
percentage=float(input("Enter the percentage:"))
entrance_exam_marks=int(input("Enter the marks:"))
if percentage>=60:
      if entrance_exam_marks>=70:
        print("Admission Garented")
      else:
          print("Entrance Marks Too low")
else:
       print("Not Eligible")
 

